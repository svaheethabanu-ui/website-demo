rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Healthcheck / connection testing
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRecord(data) {
      return data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('company' in data) || (data.company is string && data.company.size() <= 100))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.status in ['Active', 'Pending', 'Completed', 'Archived']
        && data.priority in ['Low', 'Medium', 'High', 'Critical']
        && (!('value' in data) || (data.value is number))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
    }

    match /records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && existing().userId == request.auth.uid;
      
      // Strict rule-side query enforcer without blanket reads
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(recordId)
        && isValidRecord(incoming())
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['userId', 'name', 'email', 'category', 'status', 'priority'])
        && incoming().keys().hasOnly(['id', 'userId', 'name', 'email', 'phone', 'company', 'category', 'status', 'priority', 'value', 'notes', 'tags', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn()
        && isValidId(recordId)
        && isValidRecord(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'company', 'category', 'status', 'priority', 'value', 'notes', 'tags', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(recordId)
        && existing().userId == request.auth.uid;
    }
  }
}
